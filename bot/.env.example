# Token van de Discord-app (Developer Portal > Bot). Blijft op deze pc.
DISCORD_TOKEN=

# Sauce for Zwift, op deze pc of op een andere pc in het netwerk.
# Leeg laten = alleen de klok, geen live coaching.
SAUCE_URL=http://localhost:1080

# speak = de coach spreekt en grijpt in; log = hij schrijft alleen op wat hij zou doen.
COACH=speak

# Stem. Leeg = de Nederlandse Windows-stem (Frank). Met Piper: het pad naar
# piper.exe en naar een stem, bijvoorbeeld nl_BE-nathalie-medium.onnx (het
# bijbehorende .onnx.json moet ernaast staan). Zie README.md.
PIPER_PATH=
PIPER_MODEL=

# Waar een plan vandaan mag komen, gescheiden door komma's.
PLAN_ORIGINS=https://zwb-platform.netlify.app
